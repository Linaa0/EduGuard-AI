# ============================================================
# EduGuard AI — Full-Stack Environment Configuration
# ============================================================
# Copy this file to `.env` and fill in your values.
# NEVER commit the real .env file to version control.
# ============================================================

# --- Project ---
ENVIRONMENT=development
COMPOSE_PROJECT_NAME=eduguard-ai

# --- PostgreSQL Database ---
POSTGRES_USER=eduguard
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=eduguard_ai

# --- Qdrant Vector Database (RAG) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=eduguard_rubrics

# --- EjoChat LLM API ---
EJOCHAT_API_KEY=your_ejochat_api_key_here
EJOCHAT_BASE_URL=https://api.ejochat.ai/v1
EJOCHAT_MODEL=ejochat-4o
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# --- Auth (JWT) ---
JWT_SECRET=CHANGE_ME_to_a_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- n8n Automation ---
N8N_USER=admin@eduguard.ai
N8N_PASSWORD=CHANGE_ME
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://n8n:5678/webhook/eduguard-assessment

# --- Frontend / CORS ---
CORS_ORIGINS=http://localhost:3000,http://frontend:3000
# Vite env vars use VITE_ prefix (not NEXT_PUBLIC_)
VITE_API_URL=http://localhost:8000/api/v1
VITE_APP_URL=http://localhost:3000
